# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_hostinger_database_name
DB_USER=your_hostinger_database_user
DB_PASSWORD=replace_with_a_strong_database_password
# Fail startup when production dependencies or schema are unavailable.
REQUIRE_PRODUCTION_SERVICES=true
# Keep true only until the bundled article has been imported into MySQL.
BLOG_LEGACY_FALLBACK=true

# Enquiry abuse protection
# Hostinger runs the Node app behind a trusted proxy. Set this to true so the
# application uses the first proxy-supplied client IP instead of the proxy IP.
TRUST_PROXY=true
# Generate an independent random secret of at least 32 characters. Never reuse
# the database or SMTP password and never commit the real value.
ENQUIRY_RATE_LIMIT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
ENQUIRY_IP_LIMIT_PER_HOUR=10
ENQUIRY_EMAIL_LIMIT_PER_HOUR=3

# Notification retry and monitoring
ENQUIRY_NOTIFICATION_MAX_ATTEMPTS=6
ENQUIRY_NOTIFICATION_BATCH_SIZE=5
ENQUIRY_NOTIFICATION_LEASE_SECONDS=600
ENQUIRY_NOTIFICATION_WORKER_INTERVAL_SECONDS=60
ENABLE_BACKGROUND_WORKERS=false
WORKER_STALE_GRACE_MINUTES=30
# Used by external uptime monitoring to read /api/health.
HEALTHCHECK_TOKEN=replace_with_an_independent_random_secret_of_at_least_32_characters

# Admin dashboard foundation
# Independent 32+ character secret used to hash admin login rate-limit keys.
ADMIN_AUTH_SECRET=replace_with_an_independent_random_secret_of_at_least_32_characters
# Used only to create the first admin account when the admin_users table is empty.
# Sign in once with these credentials, then remove ADMIN_BOOTSTRAP_PASSWORD from Hostinger.
ADMIN_BOOTSTRAP_EMAIL=you@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_a_unique_password_of_at_least_16_characters
ADMIN_SESSION_DAYS=7
ADMIN_LOGIN_IP_LIMIT_PER_15_MINUTES=10
ADMIN_LOGIN_EMAIL_LIMIT_PER_15_MINUTES=5

# Cloudinary journal media
# Keep the API secret server-only. The browser receives only short-lived upload signatures.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
CLOUDINARY_JOURNAL_FOLDER=presspixel-creations/journal

# SMTP notifications
# Use the SMTP details for the mailbox/provider that will SEND the alert.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@presspixelcreations.com
SMTP_PASS=replace_with_your_smtp_or_app_password
ENQUIRY_FROM_EMAIL=support@presspixelcreations.com

# Comma-separated recipients. These are the defaults in code too.
ENQUIRY_NOTIFY_TO=ashrafkhanak15@gmail.com,support@presspixelcreations.com
