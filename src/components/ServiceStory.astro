---
import Icon from './Icon.astro';
import SectionLabel from './SectionLabel.astro';
interface Props { slug:string }
const { slug } = Astro.props;
const campaigns = [['Demand','Meet a real need.','Audience + problem + timing'],['Relevance','Make the promise match.','Intent + message + offer'],['Conversion','Earn the next step.','Landing page + proof + low friction'],['Revenue signal','Learn which leads matter.','Tracking + qualification + sales feedback']];
const emails = [['01','The acknowledgement','We received it. Here is what happens next.','Reduce uncertainty immediately and set a clear expectation.'],['02','The objection','Still deciding? This may answer the question.','Use proof and useful detail to resolve a common hesitation.'],['03','The next step','Ready when you are.','Offer a proportionate way to reply, book, or continue.']];
const lenses = [['Specificity','Replace broad claims with the process, proof, trade-offs, and details that make the business credible.'],['Decision','Organise each page around what the reader needs to understand, believe, and do next.'],['Voice','Use language the business and its customers would actually say, then keep it consistent across pages and channels.']];
const care = [['Maintain','Keep the technical foundation dependable.'],['Update','Keep services, proof, and information accurate.'],['Improve','Use the monthly scope on the next useful constraint.']];
---
{slug === 'web-development' && <section class="service-story web-story wrap" id="approach"><div class="story-heading"><SectionLabel>DESIGNED AROUND THE BUYING JOURNEY</SectionLabel><h2>Four questions.<br/>One clear path.</h2></div><div class="website-map" data-flow><div class="map-top"><span>WHAT THE VISITOR IS REALLY ASKING</span><Icon name="mouse-pointer" size={20}/></div><div class="map-entry" data-flow-step><span>01 / ARRIVE</span><h3>“Do they solve my problem?”</h3><p>A specific promise for the right person, not an abstract company slogan.</p></div><div class="map-branches"><div data-flow-step><span>02 / UNDERSTAND</span><h3>“Can they handle this?”</h3><p>Services, process, and relevant detail in the order a buyer needs them.</p></div><div data-flow-step><span>03 / BELIEVE</span><h3>“Why should I trust them?”</h3><p>Proof, boundaries, answers, and signs of a real accountable business.</p></div></div><div class="map-action" data-flow-step><span>04 / ACT</span><h3>Call, book, or request a quote</h3><Icon name="arrow-right"/><p>A sensible next step with as little friction as the situation allows.</p></div></div></section>}
{slug === 'branding-seo' && <section class="service-story brand-story" id="approach"><div class="wrap"><SectionLabel>TWO JOBS. ONE CREDIBLE STORY.</SectionLabel><div class="brand-duet"><article data-reveal><span class="giant-word">Aa.</span><h2>Remember.</h2><p>Give buyers a clear position, a recognisable visual language, and specific reasons to recall you after comparing options.</p><ul><li>Positioning & differentiation</li><li>Visual identity & voice</li><li>Consistent practical guidance</li></ul></article><article data-reveal><Icon name="search" class="giant-search" strokeWidth={1}/><h2>Find.</h2><p>Build relevant, technically sound pages and local signals around the language suitable customers use when they need the service.</p><ul><li>Search intent & page structure</li><li>On-page & technical foundations</li><li>Local relevance & verification</li></ul></article></div><p class="bridge-statement">Be recognisable wherever buyers discover you.</p></div></section>}
{slug === 'digital-marketing' && <section class="service-story campaign-story wrap" id="approach"><div class="story-heading"><SectionLabel>THE CAMPAIGN, END TO END</SectionLabel><h2>A paid click crosses<br/>four commercial tests.</h2><p>Optimising only the ad leaves the expensive parts of the journey untouched.</p></div><div class="campaign-path" data-flow>{campaigns.map(([heading, description, detail], index) => <article data-flow-step><span>0{index + 1}</span><div><h3>{heading}</h3><p>{description}</p></div><small>{detail}</small><Icon name="arrow-down" size={22}/></article>)}</div></section>}
{slug === 'email-marketing' && <section class="service-story email-story" id="approach"><div class="wrap"><div class="story-heading"><SectionLabel>FOLLOW-UP WITH A REASON</SectionLabel><h2>Answer the next doubt.<br/>Then invite the next step.</h2><p>A simple lead-nurture journey built around uncertainty, not an arbitrary send calendar.</p></div><div class="email-journey" data-flow>{emails.map(([number, heading, subject, description]) => <article data-flow-step><div class="email-envelope"><Icon name="mail" size={22}/><span>{number}</span></div><small>{heading}</small><h3>{subject}</h3><p>{description}</p></article>)}</div><p class="story-footnote">Timing, triggers, consent, and human handoffs are agreed around your actual sales process and platform.</p></div></section>}
{slug === 'content-writing' && <section class="service-story content-story wrap" id="approach"><div class="editorial-note"><SectionLabel>COPY THAT HELPS SOMEONE DECIDE</SectionLabel><p class="pull-quote">“Say what you do.<br/>Prove why it matters.<br/><em>Make the next step easy.</em>”</p></div><div class="content-lenses">{lenses.map(([heading, description], index) => <article data-reveal><span>0{index + 1}</span><div><h3>{heading}</h3><p>{description}</p></div></article>)}</div></section>}
{slug === 'waas' && <section class="service-story care-story" id="approach"><div class="wrap"><div class="story-heading"><SectionLabel>GOING LIVE IS DAY ONE</SectionLabel><h2>The business changes.<br/>The website keeps up.</h2></div><div class="care-cycle" data-flow><div class="care-launch" data-flow-step><Icon name="check" size={28}/><span>THE FOUNDATION</span><h3>Build it around the business.</h3><p>A clear initial website, agreed scope, and working digital foundation.</p></div><div class="care-ongoing"><Icon name="refresh" size={36}/><h3>Keep it useful.</h3><div>{care.map(([heading, description]) => <article data-flow-step><h4>{heading}</h4><p>{description}</p></article>)}</div></div></div><a class="text-link" href="/pricing">Compare the monthly plans <Icon name="arrow-right" size={18}/></a></div></section>}
