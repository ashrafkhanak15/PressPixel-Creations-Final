---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBanner from '../components/ContactBanner.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ServiceList from '../components/ServiceList.astro';
import { projects, faqs } from '../../lib/content';
const steps = [
  ['Find the leak.', 'We trace the journey from search or ad to page, enquiry, and follow-up. Then we identify where visitors leave or enquiries go unanswered.'],
  ['Build the argument.', 'We turn your customer knowledge, proof, and offer into a clear message and page structure before decoration takes over.'],
  ['Remove the friction.', 'Design, development, copy, forms, and integrations work together so the next step feels obvious on every screen.'],
  ['Measure what matters.', 'Calls, bookings, qualified enquiries, and sales feedback tell us more than traffic alone. Those signals guide what comes next.']
];
const faqSchema = { '@type':'FAQPage', mainEntity:faqs.map(([name,text]) => ({ '@type':'Question', name, acceptedAnswer:{ '@type':'Answer', text } })) };
---
<BaseLayout title="Web Design & SEO for Service Businesses" description="PressPixel Creations builds conversion-focused websites, SEO, and digital marketing systems that help service businesses earn trust and generate qualified enquiries." schema={faqSchema}>
<main id="main">
  <section class="hero wrap"><div class="hero-top"><span class="eyebrow">For service businesses tired of being overlooked online.</span><span class="hero-coordinate">WEB DESIGN & DIGITAL GROWTH</span></div><div class="hero-stage"><h1><span class="title-line"><span>TURN VISITS.</span></span><span class="title-line"><span>INTO TRUST.</span></span><span class="title-line home-impact"><span>WIN THE WORK.</span></span></h1><div class="hero-art"><picture><source media="(max-width: 650px)" srcset="/images/presspixel-mobile-hero-final.webp" type="image/webp"/><img src="/images/presspixel-hero-desktop.webp" alt="" width="1100" height="802" fetchpriority="high"/></picture><span class="art-note">Attention is rented. Trust is earned.</span></div></div><div class="hero-bottom"><p>Your website should do more than prove your business exists. It should show the right visitor why you are worth choosing, then make it easy to get in touch.</p><a class="button button-primary" href="/contact">Find where leads are leaking <Icon name="arrow-up-right" size={19}/></a><a href="#work" class="scroll-link"><span>SEE THE THINKING</span><Icon name="arrow-down" size={18}/></a></div></section>
  <div class="discipline-strip" aria-label="Strategy, design, development, growth"><div>{[0, 1].map(i => <span aria-hidden={i === 1}>STRATEGY <Icon name="asterisk"/> DESIGN <Icon name="asterisk"/> DEVELOPMENT <Icon name="asterisk"/> GROWTH <Icon name="asterisk"/></span>)}</div></div>
  <section class="intro wrap section-space" data-reveal><SectionLabel number="01">THE PROBLEM BEHIND THE PAGE</SectionLabel><div><h2 class="statement">Most websites lose the sale<br class="desktop-break"/> before the phone rings.<br/><span>Yours does not have to.</span></h2><div class="intro-bottom"><p>A buyer arrives with four questions: Do you solve my problem? Can I trust you? Why should I choose you? What happens next? We design the website, search presence, campaigns, and follow-up around answering them.</p><a class="text-link" href="/about">See how we think <Icon name="arrow-up-right" size={18}/></a></div></div></section>
  <section class="work-section wrap section-space" id="work"><div class="section-heading"><div><SectionLabel number="02">SELECTED WORK</SectionLabel><h2>Built around<br/><span class="muted">the decision.</span></h2></div><a class="text-link" href="/work">See the project stories <Icon name="arrow-up-right" size={18}/></a></div><div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index}/>)}</div></section>
  <section class="services-section section-space" id="services"><div class="wrap services-layout"><div class="services-intro"><SectionLabel number="03">ONE CUSTOMER JOURNEY</SectionLabel><h2>Fix the leak.<br/>Then fill the pipeline.</h2><p>More traffic cannot rescue an unclear offer. A beautiful site cannot compensate for weak follow-up. Fix what is losing you business before spending more on the rest.</p><a class="text-link" href="/services">Find the right starting point <Icon name="arrow-up-right" size={18}/></a></div><ServiceList compact /></div></section>
  <section class="process wrap section-space"><SectionLabel number="04">HOW THE WORK MOVES</SectionLabel><div class="section-heading"><h2>No mystery.<br/><span class="muted">No theatre.</span></h2><p>We diagnose before prescribing, then connect every creative decision to a buyer question or business outcome.</p></div><div class="process-grid">{steps.map(([name, description], index) => <article><span class="process-number">0{index + 1}<Icon name="arrow-up-right" size={20}/></span><h3>{name}</h3><p>{description}</p></article>)}</div></section>
  <section class="faq-section wrap section-space"><div><SectionLabel number="05">BEFORE YOU INVEST</SectionLabel><h2>Questions deserve<br/>useful answers.</h2></div><FAQ /></section>
  <ContactBanner />
</main>
</BaseLayout>
