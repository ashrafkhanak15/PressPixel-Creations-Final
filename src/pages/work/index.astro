---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBanner from '../../components/ContactBanner.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { projects } from '../../../lib/content';
const principles = [
  ['Start with the anxious question.','The page should meet the uncertainty a real visitor brings, not open with a speech about the company.'],
  ['Put proof near the promise.','Specifics, process, imagery, and credibility belong where doubt naturally appears.'],
  ['Make the next action feel earned.','A call to action works best after the page has given someone enough reason to take it.']
];
---
<BaseLayout title="Web Design Case Studies" description="Explore web design case studies from PressPixel Creations and see how strategy, copy, visual design, and development shape clearer buying journeys.">
<main id="main" class="work-page">
  <section class="wrap work-hero"><SectionLabel>WEB DESIGN CASE STUDIES / 01—02</SectionLabel><h1><span class="title-line"><span>A good website makes</span></span><span class="title-line"><span>the next decision <em>easier.</em></span></span></h1><div><p>A worried pet owner and a curious meal-plan buyer arrive with different questions. Each experience is built around the decision in front of that person.</p><span>STRATEGY<br/>WEB DESIGN<br/>DEVELOPMENT</span></div></section>
  <section class="wrap work-editorial">{projects.map((project, index) => <article class={`work-feature feature-${project.slug}`}><div class="work-feature-copy"><SectionLabel number={`0${index + 1}`}>{project.sector}</SectionLabel><h2>{project.name}</h2><p>{project.description}</p><dl><dt>THE BUYING QUESTION</dt><dd>{index === 0 ? 'Can I trust this clinic with an animal I love?' : 'Is this subscription useful enough to fit my routine?'}</dd></dl><a class="text-link" href={`/work/${project.slug}`}>Inside the decisions <Icon name="arrow-up-right" size={18}/></a></div><ProjectCard project={project} index={index}/></article>)}</section>
  <section class="work-principles"><div class="wrap"><SectionLabel>WHAT CONNECTS THE WORK</SectionLabel><div class="work-principle-grid"><h2>Different audiences.<br/><span>The same discipline.</span></h2><div>{principles.map(([heading, description]) => <article data-reveal><h3>{heading}</h3><p>{description}</p></article>)}</div></div></div></section>
  <section class="wrap work-invitation section-space"><SectionLabel>THE NEXT CASE STUDY COULD BE YOURS</SectionLabel><h2>Bring the bottleneck.<br/>We will find the story.</h2><p>Show us the current website, the clients you want more of, and the point where good prospects are dropping away. We will tell you what we would change and why.</p><a class="text-link" href="/contact">Discuss your website <Icon name="arrow-up-right" size={18}/></a></section>
  <ContactBanner />
</main>
</BaseLayout>
